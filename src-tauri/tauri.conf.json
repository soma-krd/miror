{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miror",
  "version": "1.0.0",
  "identifier": "com.miror.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:desktop",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Miror — Command Module for Local Dev",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-icon-template.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Miror — click to manage services"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/app-icon-128.png",
      "icons/app-icon-256.png",
      "icons/app-icon-512.png",
      "icons/app-icon-1024.png"
    ],
    "resources": [
      "binaries/miror-backend-*"
    ],
    "externalBin": [
      "binaries/miror-backend"
    ],
    "publisher": "Miror",
    "category": "DeveloperTool",
    "shortDescription": "Command module for local dev environments",
    "longDescription": "Miror is a cross-platform desktop control tower for managing multiple projects and their services from a single unified panel with system tray integration.",
    "copyright": "© 2026 Miror",
    "macOS": {
      "frameworks": ["AppKit"],
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libappindicator3-1", "libnotify4"]
      }
    }
  }
}
